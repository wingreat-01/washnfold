{
  "redirects": [
    {
      "source": "/landing/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/track",
      "destination": "/track/index.html"
    },
    {
      "source": "/track/:orderId",
      "destination": "/app/index.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password/index.html"
    },
    {
      "source": "/reset-password/:path*",
      "destination": "/reset-password/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/delete-account/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
